{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/private/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin-disabled.html",
      "permanent": false
    },
    {
      "source": "/admin/((?!blog).*)",
      "destination": "/admin-disabled.html",
      "permanent": false
    },
    {
      "source": "/builder-pricing",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/builder-pricing.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:slug((?!connect$|connections$|apipartners$|platform$|admin$|api$|sitemap|robots|css$|js$|images$|videos$|fonts$|appResources$|supabase$|private$|docs$|i18n$|backup$|video$|other-pages$|scripts$|protected-content$|blog$|ar$|bn$|de$|es$|fr$|he$|hi$|id$|it$|ja$|ko$|nl$|pl$|pt$|ru$|sv$|th$|tr$|vi$|zh$)[^./]+)",
      "destination": "/:slug.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/posts/:slug",
      "destination": "/blog/posts/:slug/index.html"
    },
    {
      "source": "/blog/posts/:slug/",
      "destination": "/blog/posts/:slug/index.html"
    },
    {
      "source": "/blog/category/:slug",
      "destination": "/blog/category/:slug/index.html"
    },
    {
      "source": "/blog/category/:slug/",
      "destination": "/blog/category/:slug/index.html"
    }
  ]
}
